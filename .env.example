# Backend service: HTTPS public origin without final slash
VEIL_PUBLIC_ORIGIN=https://YOUR-BACKEND.example.com
# Exact GitHub Pages origin, e.g. https://YOURNAME.github.io (NO repository path)
VEIL_FRONTEND_ORIGIN=https://YOURNAME.github.io
# Must be mounted on a real, durable volume; do not use /tmp
VEIL_DATA_DIR=/data
PORT=4173
# Exija e-mail confirmado para acessar clãs, raids e cloud em ambiente público
VEIL_REQUIRE_EMAIL=1
# Envio de e-mails; configure estas variáveis como SEGREDOS, não commit no GitHub
RESEND_API_KEY=SEU_SEGREDO_AQUI
VEIL_EMAIL_FROM=Veilfall <contas@SEU_DOMINIO_VERIFICADO.com>
# URL pública COMPLETA do site, incluindo /nome-repositorio/
VEIL_FRONTEND_URL=https://YOURNAME.github.io/YOUR_REPO/
VEIL_BIND=0.0.0.0
# Frontend GitHub Actions repository variable (NOT a password)
# VEIL_API_URL=https://YOUR-BACKEND.example.com
